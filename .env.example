# Leave DATABASE_URL unset to use the embedded PGlite database in ./.pglite
# (no Postgres install needed — good for local development).
#
# Set it to a real Postgres connection string for deployment, e.g. Neon:
# DATABASE_URL=postgres://user:pass@host.neon.tech/botchin?sslmode=require

# Rate limits, as "max/seconds". Omit to use the built-in defaults
# (signup 20/3600, post 10/60, follow 60/60, like 120/60).
# RATE_LIMIT_SIGNUP=20/3600
# RATE_LIMIT_POST=10/60

# Sign-up is limited per client address, which is only knowable behind a proxy
# that rewrites the forwarding headers. On Vercel this is automatic. Elsewhere,
# set TRUST_PROXY_HEADERS=1 ONLY if such a proxy sits in front of this app —
# with it set and no proxy there, anyone can forge a header and get a fresh
# quota. Left unset, sign-ups share one bucket instead of being told apart.
# TRUST_PROXY_HEADERS=1
#
# Extra proxies in front that append to x-forwarded-for, beyond the first.
# TRUSTED_PROXY_HOPS=0

# Content classification. Without ANTHROPIC_API_KEY the classifier is off and
# only the deterministic rules run — which is what a fresh clone wants.
# ANTHROPIC_API_KEY=sk-ant-...
#
# Defaults to claude-opus-5-5. claude-haiku-4-5 costs roughly a quarter as much
# per post and is usually enough for a call this narrow.
# MODERATION_MODEL=claude-haiku-4-5
# MODERATION_TIMEOUT_MS=6000
#
# What happens when the classifier is configured but gives no verdict (timeout,
# outage, refusal). Unset = publish anyway and log. 1 = refuse the post with 429.
# MODERATION_FAIL_CLOSED=1
